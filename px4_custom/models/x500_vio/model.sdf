<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_vio'>
    <self_collide>false</self_collide>

    <!-- The stock drone: base_link, rotors, IMU, NavSat, motors -->
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- VIO camera: its own small link, placed at T_imu_cam relative to base_link -->
    <link name='vio_camera_link'>
      <pose relative_to='base_link'>0.13233 0 0.02078 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-7</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-7</iyy><iyz>0</iyz>
          <izz>1e-7</izz>
        </inertia>
      </inertial>
      <sensor name='vio_camera' type='camera'>
        <gz_frame_id>vio_camera_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/vio/camera/image</topic>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name='VioCameraJoint' type='fixed'>
      <parent>base_link</parent>
      <child>vio_camera_link</child>
    </joint>
  </model>
</sdf>