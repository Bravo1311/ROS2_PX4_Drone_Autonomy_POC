# Which simulation the bringup launches use. THE ONE PLACE to change it.
#
# Plain KEY=VALUE lines (no quotes, no spaces around '='); whole-line comments only.
# Read by px4_bringup/sim_config.py (every launch file) and docker/start_sim.sh.
# A variable already exported in your shell wins over this file, for one-off runs:
#   PX4_GZ_WORLD=vio_rich ros2 launch px4_bringup minimal.launch.py
# After editing, run:  colcon build --packages-select px4_bringup  (the file is installed).
# No secrets here (those go in the git-ignored .env at the repo root).

# Gazebo world: the .sdf file name without extension (px4_custom/worlds/<name>.sdf)
PX4_GZ_WORLD=vio_rich

# PX4 make target; the Gazebo model name is derived from it (gz_x500_mono_cam_down -> x500_mono_cam_down)
PX4_VEHICLE=gz_x500_mono_cam_down

# PX4 instance number; the spawned model is <model>_<instance>, e.g. x500_mono_cam_down_0
PX4_GZ_INSTANCE=0
